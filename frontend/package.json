{
  "name": "punland-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tune Story (Punland): browser point-and-click adventure, Phaser + Vite",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "npm run build && node tests/serve.mjs 4173",
